generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id           Int           @id @default(autoincrement())
  name         String
  competitions Competition[]
}

model Competition {
  id             Int          @id @default(autoincrement())
  name           String
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  seasons        Season[]
}

model Season {
  id            Int         @id @default(autoincrement())
  startDate     DateTime
  endDate       DateTime
  competitionId Int
  competition   Competition @relation(fields: [competitionId], references: [id])
  matches       Match[]
}

model Team {
  id             Int              @id @default(autoincrement())
  name           String
  abbreviation   String
  crest          String?
  president      String?
  stadiumId      Int?
  stadium        Stadium?         @relation(fields: [stadiumId], references: [id])
  homeMatches    Match[]          @relation("HomeTeam")
  awayMatches    Match[]          @relation("AwayTeam")
  players        TeamPlayer[]
  matchLineups   MatchLineup[]
  matchTeamStats MatchTeamStats[]
}

model Stadium {
  id       Int     @id @default(autoincrement())
  name     String
  capacity Int
  address  String
  matches  Match[]
  teams    Team[]
}

model Match {
  id         Int              @id @default(autoincrement())
  dateTime   DateTime
  status     MatchStatus
  seasonId   Int
  stadiumId  Int
  homeTeamId Int
  awayTeamId Int
  season     Season           @relation(fields: [seasonId], references: [id])
  stadium    Stadium          @relation(fields: [stadiumId], references: [id])
  homeTeam   Team             @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam   Team             @relation("AwayTeam", fields: [awayTeamId], references: [id])
  lineups    MatchLineup[]
  stats      MatchTeamStats[]
}

model Player {
  id            Int           @id @default(autoincrement())
  firstName     String
  lastName      String
  birthDate     DateTime
  position      String
  nationality   String
  overall       Int
  height        Float
  weight        Float
  preferredFoot PreferredFoot
  marketValue   Decimal?      @db.Decimal(12, 2)
  annualSalary  Decimal?      @db.Decimal(12, 2)
  teams         TeamPlayer[]
  lineups       MatchLineup[]
}

model TeamPlayer {
  id        Int       @id @default(autoincrement())
  teamId    Int
  playerId  Int
  startDate DateTime
  endDate   DateTime?
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([playerId])
}

model MatchLineup {
  id          Int     @id @default(autoincrement())
  matchId     Int
  teamId      Int
  playerId    Int
  starter     Boolean @default(false)
  shirtNumber Int?
  position    String?
  match       Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team        Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player      Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([matchId, teamId])
}

model MatchTeamStats {
  id              Int   @id @default(autoincrement())
  matchId         Int
  teamId          Int
  possession      Int   @default(0)
  shots           Int   @default(0)
  shotsOnTarget   Int   @default(0)
  fouls           Int   @default(0)
  offsides        Int   @default(0)
  corners         Int   @default(0)
  freeKicks       Int   @default(0)
  passes          Int   @default(0)
  completedPasses Int   @default(0)
  crosses         Int   @default(0)
  interceptions   Int   @default(0)
  tackles         Int   @default(0)
  saves           Int   @default(0)
  yellowCards     Int   @default(0)
  redCards        Int   @default(0)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([matchId, teamId])
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}

enum PreferredFoot {
  LEFT
  RIGHT
  BOTH
}
